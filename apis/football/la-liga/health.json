{
  "league": "la-liga",
  "name": "LaLiga",
  "baseUrl": "https://apim.laliga.com/public-service",
  "headers": {
    "Ocp-Apim-Subscription-Key": "{secret.laliga.publicService}",
    "Content-Language": "en"
  },
  "checks": [
    {
      "name": "laliga.com page carries the subscription keys",
      "url": "https://www.laliga.com/en-GB",
      "format": "text",
      "note": "LaLigaKeys.discover reads backendSubscription/webviewSubscription from __NEXT_DATA__"
    },
    {
      "name": "api/v1/competitions",
      "path": "/api/v1/competitions",
      "sample": "competitions.json",
      "keys": [
        "competitions[]"
      ]
    },
    {
      "name": "api/v1/competitions/{slug}",
      "path": "/api/v1/competitions/primera-division?seasonYear=2026",
      "sample": "competition.json"
    },
    {
      "name": "api/v1/subscriptions?competitionSlug",
      "path": "/api/v1/subscriptions?competitionSlug=primera-division",
      "sample": "subscriptions.json",
      "keys": [
        "subscriptions[].slug",
        "total"
      ]
    },
    {
      "name": "api/v1/subscriptions/{slug}",
      "path": "/api/v1/subscriptions/laliga-easports-2026",
      "sample": "subscription.json",
      "keys": [
        "subscription"
      ]
    },
    {
      "name": "api/v1/subscriptions/{slug} — Hypermotion",
      "path": "/api/v1/subscriptions/laliga-hypermotion-2026",
      "sample": "subscriptions-hypermotion.json",
      "keys": [
        "subscription"
      ]
    },
    {
      "name": "api/v1/subscriptions/{slug}/current-gameweek",
      "path": "/api/v1/subscriptions/laliga-easports-2026/current-gameweek",
      "sample": "subscription-current-gameweek.json"
    },
    {
      "name": "api/v1/subscriptions/{slug}/gameweeks",
