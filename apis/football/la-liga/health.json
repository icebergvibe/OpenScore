      "sample": "subscription-standing-gameweeks.json"
    },
    {
      "name": "api/v1/calendar",
      "path": "/api/v1/calendar?startDate={today}&endDate={today}&competitionSlug=primera-division",
      "sample": "calendar.json",
      "keys": [
        "calendars"
      ]
    },
    {
      "name": "api/v1/matches?week — final",
      "path": "/api/v1/matches?subscriptionSlug=laliga-easports-2026&week=4&limit=100&orderField=date&orderType=asc",
      "sample": "matches-week.final.json",
      "keys": [
        "matches[].slug",
        "matches[].status",
        "matches[].home_team",
        "matches[].date",
        "total"
      ]
    },
    {
      "name": "api/v1/matches?week — pre",
      "path": "/api/v1/matches?subscriptionSlug=laliga-easports-2026&week=5&limit=100&orderField=date&orderType=asc",
