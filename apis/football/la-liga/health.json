      "sample": "matches-team.json",
      "keys": [
        "matches[]"
      ],
      "depth": 1
    },
    {
      "name": "api/v1/matches?status",
      "path": "/api/v1/matches?subscriptionSlug=laliga-easports-2026&status=PreMatch&limit=3",
