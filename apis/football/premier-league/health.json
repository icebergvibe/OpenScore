      "keys": [
        "data[].matchId",
        "data[].kickoff"
      ]
    },
    {
      "name": "v2/matches",
      "path": "/v2/matches?competition=8&season=2026",
      "sample": "matches.json",
      "keys": [
        "data[].matchId",
        "pagination"
      ]
    },
    {
      "name": "v2/matches — kickoff range",
      "path": "/v2/matches?competition=8&season=2026&kickoff%3E{today}&kickoff%3C{today+1}&_limit=100",
      "sample": "matches-daterange.json",
      "note": "Empty on a day without matches"
    },
    {
      "name": "v2/matches — team",
      "path": "/v2/matches?competition=8&season=2026&team=3&_limit=5",
