  "checks": [
    {
      "name": "v1/…/matchweeks/{n}/matches — final",
      "path": "/v1/competitions/8/seasons/2026/matchweeks/3/matches",
      "sample": "matchweek-matches.final.json",
      "keys": [
        "data[].matchId",
        "data[].period",
        "data[].homeTeam",
        "pagination"
      ]
    },
    {
      "name": "v1/…/matchweeks/{n}/matches — pre",
