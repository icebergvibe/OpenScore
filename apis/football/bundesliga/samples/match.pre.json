    "7503554830623834112": {
      "conference": true,
      "detail": {
        "copyright": "IMAGO/Malte Ossowski/SVEN SIMON",
        "headline": "Miron Muslić on facing Union",
        "text": "\"In our last home game we were delighted with how we stuck to our principles and our structure from the first whistle to the last. We’ll need that intensity again on Friday evening. Union Berlin are an experienced Bundesliga team with a clear way of playing; very vertical, very direct, with a strong focus on second balls and set-pieces. But we’re very well prepared. We want to play intense football again.\"",
        "url": "https://assets.bundesliga.com/contender/2026/8/imago1082661892h.jpg?crop=479px,216px,4972px,3317px"
      },
      "enableHtml": false,
      "entryDate": "2026-09-09T22:46:44+0200",
