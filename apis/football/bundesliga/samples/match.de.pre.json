    "7502757422197374976": {
      "conference": false,
      "detail": {
        "headline": "Karius oft gefordert",
        "text": "Loris Karius (2020/21: vier Bundesliga-Spiele für Union Berlin) bekam an den ersten beiden Spieltagen 17 Schüsse auf sein Tor – nur Mönchengladbachs Moritz Nicolas und Frankfurts Noah Atubolu waren noch öfter gefordert. Der 33-jährige Schalker zeigte 14 Paraden gegen die Bayern – das ist gleichauf mit Nicolas der Bundesliga-Bestwert."
      },
