{
  "league": "ucl",
  "name": "UEFA competitions (Champions League / Europa League / Conference League / Nations League)",
  "baseUrl": "https://match.uefa.com/v5",
  "checks": [
    {
      "name": "competitions?competitionIds=1,14,2019",
      "url": "https://comp.uefa.com/v2/competitions?competitionIds=1,14,2019",
      "sample": "competitions.json",
      "keys": [
        "[].id",
        "[].code",
        "[].metaData.name"
      ]
    },
    {
      "name": "matches — UCL day (finished)",
      "path": "/matches?competitionId=1&fromDate=2026-09-08&toDate=2026-09-08&limit=50&offset=0&order=ASC",
      "sample": "matches.day.json",
      "keys": [
        "[].id",
        "[].status",
        "[].kickOffTime.dateTime",
        "[].homeTeam.id",
        "[].awayTeam.id",
        "[].score.total",
        "[].round.metaData.name"
      ]
    },
    {
      "name": "matches — UEL day",
      "path": "/matches?competitionId=14&fromDate=2026-09-16&toDate=2026-09-16&limit=50&offset=0&order=ASC",
      "sample": "matches.day-pre.json",
      "keys": [
        "[].id",
        "[].status"
      ],
      "note": "captured before kick-off; the shape gains score/winner once played"
    },
    {
      "name": "matches — UECL day",
      "path": "/matches?competitionId=2019&fromDate=2026-10-15&toDate=2026-10-15&limit=50&offset=0&order=ASC",
      "sample": "matches.day-uecl.json",
      "keys": [
        "[].id",
        "[].status"
      ],
      "note": "captured before kick-off; the shape gains score/winner once played"
    },
    {
      "name": "matches — today (all UCL games, may be empty)",
      "path": "/matches?competitionId=1&fromDate={today}&toDate={today}&limit=50&offset=0&order=ASC",
      "sample": "matches.empty.json",
      "depth": 0
    },
    {
      "name": "matches?matchId=…",
      "path": "/matches?matchId=2049553,2050063",
      "sample": "matches.by-id.json",
      "keys": [
        "[].id",
        "[].status"
      ]
    },
    {
      "name": "matches — season list",
      "path": "/matches?competitionId=1&seasonYear=2027&limit=5&offset=0&order=ASC",
      "sample": "matches.season.json",
      "keys": [
        "[].id",
        "[].round.phase",
        "[].competitionPhase"
      ]
    },
    {
      "name": "matches/{id} — final",
      "path": "/matches/2049553",
      "sample": "match.final.json",
      "keys": [
        "id",
        "status",
        "kickOffTime.dateTime",
        "score.regular",
        "score.total",
        "winner.match.reason",
        "playerEvents.scorers[].time.minute",
        "lineupStatus",
        "round.mode"
      ]
    },
    {
      "name": "matches/{id} — pre (UEL 2050063)",
      "path": "/matches/2050063",
      "sample": "match.pre.json",
      "keys": [
        "id",
        "status",
        "kickOffTime.dateTime"
      ],
      "note": "captured UPCOMING; the live response gains score/winner once played"
    },
    {
      "name": "matches/{id} — second leg with aggregate",
      "path": "/matches/2048635",
      "sample": "match.final-two-legs.json",
      "keys": [
        "score.aggregate",
        "winner.aggregate.reason",
        "relatedMatches[].id"
      ]
    },
    {
      "name": "matches/{id} — extra time",
      "path": "/matches/2047770",
      "sample": "match.final-extra-time.json",
      "keys": [
        "score.regular",
        "score.total"
      ]
    },
    {
      "name": "matches/{id} — penalties",
      "path": "/matches/2047742",
      "sample": "match.final-penalties.json",
      "keys": [
        "score.penalty",
        "playerEvents.penaltyScorers[].penaltyType"
      ]
    },
    {
      "name": "matches/{id} — unknown id",
      "path": "/matches/999999999",
      "status": [
        404
      ],
      "sample": "match.not-found.json",
      "keys": [
        "error.status"
      ]
    },
    {
      "name": "matches/{id}/events?filter=MAIN",
      "path": "/matches/2049553/events?filter=MAIN&order=ASC&limit=500&offset=0",
      "sample": "match-events.main.final.json",
      "keys": [
        "[].id",
        "[].type",
        "[].phase",
        "[].timestamp",
        "[].time.minute",
        "[].primaryActor.person.id",
        "[].primaryActor.team.id"
      ]
    },
    {
      "name": "matches/{id}/events?filter=ALL",
      "path": "/matches/2049553/events?filter=ALL&order=ASC&limit=40&offset=0",
      "sample": "match-events.all.final.json",
      "keys": [
        "[].type"
      ]
    },
    {
      "name": "matches/{id}/events?filter=LINEUP",
