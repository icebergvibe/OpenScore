      "keys": [
        "[].type"
      ]
    },
    {
      "name": "matches/{id}/events?filter=PHASES",
      "path": "/matches/2049553/events?filter=PHASES&order=ASC&limit=500&offset=0",
      "sample": "match-events.phases.final.json",
      "keys": [
        "[].type",
        "[].timestamp"
      ]
    },
    {
      "name": "matches/{id}/events — shoot-out",
      "path": "/matches/2047742/events?filter=MAIN&order=ASC&limit=500&offset=0",
      "sample": "match-events.main.final-penalties.json",
      "keys": [
        "[].subType"
      ]
    },
    {
      "name": "matches/{id}/events — own goal",
      "path": "/matches/2048624/events?filter=MAIN&order=ASC&limit=500&offset=0",
      "sample": "match-events.main.own-goal.json",
      "keys": [
        "[].subType"
      ]
    },
    {
      "name": "matches/{id}/events — extra-time phases",
      "path": "/matches/2047770/events?filter=PHASES&order=ASC&limit=500&offset=0",
      "sample": "match-events.phases.final-extra-time.json",
      "keys": [
        "[].phase"
      ]
    },
    {
      "name": "matches/{id}/events — pre (empty)",
      "path": "/matches/2050063/events?filter=MAIN&order=ASC&limit=500&offset=0",
      "sample": "match-events.main.pre.json",
      "depth": 0,
      "note": "[] until kick-off; filled once played"
    },
    {
      "name": "matches/{id}/lineups — final",
      "path": "/matches/2049553/lineups",
      "sample": "match-lineups.final.json",
      "keys": [
        "lineupStatus",
        "homeTeam.field[].player.id",
        "homeTeam.bench[].player.id",
        "awayTeam.field[].jerseyNumber",
        "homeTeam.coaches[].person.id"
