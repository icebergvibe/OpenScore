    {
      "name": "livescore",
      "path": "/livescore",
      "sample": "livescore.json",
      "depth": 0,
      "note": "[] outside the ±1 h windows around matches"
    },
    {
      "name": "team-statistics/{id} — final",
      "url": "https://matchstats.uefa.com/v1/team-statistics/2049553",
      "sample": "team-statistics.final.json",
      "keys": [
        "[].teamId",
        "[].statistics[].name",
        "[].statistics[].value"
