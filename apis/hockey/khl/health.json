{
  "league": "khl",
  "name": "KHL",
  "baseUrl": "https://khl.api.webcaster.pro/api/khl_mobile",
  "checks": [
    {
      "name": "events_v2.json (default)",
      "path": "/events_v2.json?locale=en",
      "sample": "events_v2.json",
      "keys": [
        "[].event.id",
        "[].event.khl_id",
        "[].event.start_at",
        "[].event.team_a",
        "[].event.team_b",
        "[].event.game_state_key"
      ]
    },
    {
      "name": "events_v2.json — one day",
      "path": "/events_v2.json?locale=en&order_direction=asc&q[start_at_gt_time_from_unixtime]={today|epoch}&q[start_at_lt_time_from_unixtime]={today+1|epoch}",
      "sample": "events_v2.date-range.json",
      "note": "Bare array; empty on an off-day"
    },
    {
      "name": "events_v2.json — previous stage",
      "path": "/events_v2.json?locale=en&stage_id=370",
      "sample": "events_v2.stage-370.json",
      "keys": [
        "[].event.id"
      ]
    },
    {
      "name": "events_v2.json — team",
      "path": "/events_v2.json?locale=en&q[team_a_or_team_b_in][]=40",
      "sample": "events_v2.team.json",
      "keys": [
        "[].event.id"
      ]
    },
    {
      "name": "events_v2.json — ru",
      "path": "/events_v2.json",
      "sample": "events_v2.ru.json",
      "keys": [
        "[].event.id"
      ]
    },
    {
      "name": "event_v2.json — pre",
      "path": "/event_v2.json?id=3000171&locale=en",
      "sample": "event_v2.pre.json",
      "keys": [
        "event.id",
        "event.game_state_key",
        "event.team_a",
        "event.team_b"
      ]
    },
    {
      "name": "event_v2.json — final",
      "path": "/event_v2.json?id=3000051&locale=en",
      "sample": "event_v2.final.json",
      "keys": [
        "event.score",
        "event.goals",
        "event.period"
      ]
    },
    {
      "name": "event_v2.json — overtime",
      "path": "/event_v2.json?id=2786578&locale=en",
      "sample": "event_v2.final-overtime.json"
    },
    {
      "name": "event_v2.json — shootout",
      "path": "/event_v2.json?id=2786714&locale=en",
      "sample": "event_v2.final-shootout.json"
    },
    {
      "name": "data.json",
      "path": "/data.json",
      "sample": "data.json",
      "keys": [
        "current_stage_id",
        "stages_v2[].id",
        "teams[].id",
        "mqtt_broker.host"
      ]
    },
    {
      "name": "tables_v2.json",
      "path": "/tables_v2.json?locale=en&stage_id=407",
      "sample": "tables_v2.json",
      "keys": [
        "[].season",
        "[].tables",
        "[].stages[]"
      ]
    },
    {
      "name": "tables.json",
      "path": "/tables.json",
      "sample": "tables.json"
    },
    {
      "name": "players_v2.json?team_id",
      "path": "/players_v2.json?locale=en&team_id=40",
      "sample": "players_v2.json",
      "keys": [
        "[].player.id",
        "[].player.name",
        "[].player.role_key"
      ]
    },
    {
      "name": "teams_v2.json",
      "path": "/teams_v2.json?locale=en",
      "sample": "teams_v2.json",
      "keys": [
        "[].team.id",
        "[].team.name",
        "[].team.conference_key"
      ]
    },
    {
      "name": "teams.json",
      "path": "/teams.json",
      "sample": "teams.json"
    },
    {
      "name": "events_alloc.json",
      "path": "/events_alloc.json",
      "sample": "events_alloc.json"
    },
    {
      "name": "calendar_days.json",
      "path": "/calendar_days.json",
      "sample": "calendar_days.json",
      "depth": 1
    },
    {
      "name": "events_attrs.json",
      "path": "/events_attrs.json",
      "sample": "events_attrs.json",
      "depth": 1
    }
  ]
