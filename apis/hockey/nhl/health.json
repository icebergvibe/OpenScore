      "sample": "playoff-series-carousel.json"
    },
    {
      "name": "location",
      "path": "/location",
      "keys": [
        "country"
      ]
    },
    {
      "name": "stats REST: team",
      "url": "https://api.nhle.com/stats/rest/en/team",
      "keys": [
        "data[]",
        "total"
      ],
      "note": "Secondary stats API (Cayenne queries); not sampled"
    }
