      "keys": [
        "standings[]"
      ]
    },
    {
      "name": "standings/{date}",
      "path": "/standings/2026-04-17",
      "sample": "standings.json",
      "keys": [
        "standings[].teamAbbrev",
        "standings[].points"
      ]
    },
    {
      "name": "standings-season",
      "path": "/standings-season",
      "sample": "standings-season.json",
      "keys": [
        "seasons[]"
      ]
    },
    {
