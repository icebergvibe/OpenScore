    {
      "name": "gamecenter/{id}/boxscore — final",
      "path": "/gamecenter/2025030416/boxscore",
      "sample": "gamecenter-boxscore.final.json",
      "keys": [
        "playerByGameStats.homeTeam",
        "playerByGameStats.awayTeam"
      ]
    },
    {
      "name": "gamecenter/{id}/landing — pre",
