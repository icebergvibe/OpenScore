{
  "league": "nhl",
  "name": "NHL",
  "baseUrl": "https://api-web.nhle.com/v1",
  "checks": [
    {
      "name": "score/{date}",
      "path": "/score/{today}",
      "sample": "score.json",
      "keys": [
        "games[]",
        "gameWeek[]"
      ]
    },
    {
      "name": "score/now",
      "path": "/score/now",
      "sample": "score.json",
      "keys": [
        "games[]"
      ]
    },
    {
      "name": "score/{date} — finished day",
      "path": "/score/2026-06-14",
      "sample": "score.final.json",
      "keys": [
        "games[].gameState",
        "games[].homeTeam.score"
      ]
    },
    {
      "name": "schedule/{date}",
      "path": "/schedule/{today}",
      "keys": [
        "gameWeek[]",
        "regularSeasonStartDate"
      ],
      "depth": 0
    },
    {
      "name": "schedule/now",
      "path": "/schedule/now",
      "sample": "schedule.json",
      "keys": [
        "gameWeek[]"
      ]
    },
    {
      "name": "schedule-calendar/{date}",
      "path": "/schedule-calendar/{today}",
      "sample": "schedule-calendar.json",
      "keys": [
        "teams[]"
      ]
    },
    {
