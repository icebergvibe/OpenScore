        "[].meta._vierasjoukkue_wp_id",
        "[].meta._kotimaalit",
        "[].meta._kausi",
        "[].meta._sarja"
      ]
    },
    {
      "name": "season match records, page 3",
      "path": "/wp-json/wp/v2/ottelut?per_page=100&page=3&orderby=id&order=desc&_fields=id,slug,modified,meta._torneopal_id,meta._ottelu_aika,meta._kotijoukkue_torneopal_id,meta._kotijoukkue_wp_id,meta._vierasjoukkue_torneopal_id,meta._vierasjoukkue_wp_id,meta._kotimaalit,meta._vierasmaalit,meta._kausi,meta._sarja,meta._ryhma_nimi,meta._kierros_nimi,meta._yleisomaara",
