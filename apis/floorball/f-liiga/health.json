        "[].id",
        "[].slug",
        "[].meta._torneopal_id",
        "[].meta._ottelu_aika",
        "[].meta._kotijoukkue_wp_id",
        "[].meta._vierasjoukkue_wp_id",
        "[].meta._kotimaalit",
        "[].meta._kausi",
        "[].meta._sarja"
      ]
