        "[].games",
        "[].points"
      ]
    },
    {
      "name": "player points",
      "path": "/wp-admin/admin-ajax.php?action=fliiga_scoreboard_points&season=2026-2027&phase=&series=miehet&lang=en",
      "sample": "player-points.json",
      "keys": [
        "[].torneopal_id",
        "[].wp_post_id",
        "[].games_played",
        "[].goals",
        "[].assists"
      ]
    },
    {
      "name": "goalkeepers",
      "path": "/wp-admin/admin-ajax.php?action=fliiga_scoreboard_goalkeepers&season=2026-2027&phase=&series=miehet&lang=en",
      "sample": "goalkeepers.json",
      "keys": [
        "[].torneopal_id",
        "[].games_played",
        "[].saves",
        "[].conceded",
        "[].save_percentage"
      ]
    },
    {
      "name": "current teams",
      "path": "/wp-json/wp/v2/joukkueet?include=8152,8154,8146,8157,8153,8155,8145,8141,8142,8147,8158,8150&per_page=12&orderby=include&_fields=id,slug,link,title,meta._torneopal_id,meta._liittyva_seura_torneopal_id,meta._liittyva_seura_wp_id",
      "sample": "teams.json",
      "keys": [
        "[].id",
        "[].meta._torneopal_id",
        "[].meta._liittyva_seura_torneopal_id"
      ]
    },
    {
      "name": "player profile metadata",
      "path": "/wp-json/wp/v2/pelaajat/24997",
      "sample": "player.json",
      "keys": [
        "id",
        "meta._torneopal_id",
        "meta._liittyva_joukkue_torneopal_id",
        "meta._liittyva_joukkue_wp_id"
      ]
    },
    {
      "name": "match summary (final, second game of the day)",
      "path": "/wp-admin/admin-ajax.php?action=match_live_data&lang=en&match_id=929785",
      "sample": "match-summary.final-krp.json",
      "keys": [
        "torneopal_id",
        "status",
        "home_goals",
        "away_goals",
        "venue_name"
      ]
