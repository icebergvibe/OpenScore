    {
      "name": "men's schedule page",
      "path": "/en/matches/men/",
      "format": "text",
      "sample": "schedule.html",
      "depth": 0
    },
    {
      "name": "match metadata by slug",
      "path": "/wp-json/wp/v2/ottelut?slug=ols-o2-jyvaskyla-20-9-2026&_fields=id,slug,link,modified,meta",
      "sample": "match-by-slug.final.json",
      "keys": [
        "[].id",
        "[].meta._torneopal_id",
        "[].meta._ottelu_aika",
        "[].meta._kotijoukkue_wp_id",
        "[].meta._vierasjoukkue_wp_id"
      ]
    },
    {
      "name": "match summary (final)",
      "path": "/wp-admin/admin-ajax.php?action=match_live_data&lang=en&match_id=929774",
      "sample": "match-summary.final.json",
      "keys": [
        "torneopal_id",
        "status",
        "home_team.torneopal_id",
        "away_team.torneopal_id",
        "player_stats[].player.torneopal_id"
      ]
    },
    {
      "name": "match detail (final)",
      "path": "/wp-admin/admin-ajax.php?action=match_teams&match_id=929774",
      "sample": "match-detail.final.json",
      "keys": [
        "torneopal_id",
        "season.torneopal_id",
        "result.period_scores.p1.home",
        "lineups.home.players[].torneopal_id",
        "lineups.away.players[].torneopal_id",
        "events[].event_code"
      ]
    },
    {
      "name": "standings",
      "path": "/wp-admin/admin-ajax.php?action=fliiga_scoreboard_standings&season=2026-2027&phase=&series=miehet&lang=en",
